# Local backend through Vite's /api proxy. Set BASE_URL to an API origin
# (without /api) to call a separately hosted backend directly.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8090

# Workflow URLs are configured on BE, not in public FE settings.

# Positive numbers; invalid values fall back to 30000 ms and 10 MB.
VITE_NOTIFICATION_POLL_INTERVAL_MS=30000
VITE_MAX_SRS_FILE_SIZE_MB=10

# Vite proxy targets apply to the dev server. Production needs a reverse proxy
# for /api, or a direct backend URL configured before building.
# VITE_* values are public build-time settings. Never put secrets here.
